; REMARKS-NEXT:   - String:          ' instructions in function'
; REMARKS-NEXT: ...
; ASM-LABEL: add:
; ASM:         leal (%rdi,%rsi), %eax
; ASM-NEXT:    retq
  %c = add i32 %a, %b
  ret i32 %c
}
