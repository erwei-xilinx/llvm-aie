; REMARKS-NEXT:   - String:          "\n"
; REMARKS-NEXT:   - String:          'leal	'
; REMARKS-NEXT:   - String:          ': '
; REMARKS-NEXT:   - INST_leal:       '1'
; REMARKS-NEXT:   - String:          "\n"
; REMARKS-NEXT:   - String:          retq
; REMARKS-NEXT:   - String:          ': '
; REMARKS-NEXT:   - INST_retq:       '1'
; REMARKS-NEXT:   - String:          "\n"
; REMARKS-NEXT: ...
; REMARKS: --- !Analysis
; REMARKS-NEXT: Pass:            asm-printer
; REMARKS-NEXT: Name:            InstructionCount
; REMARKS-NEXT: Function:        add
